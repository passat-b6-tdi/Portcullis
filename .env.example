# No private key here. The deployer key lives in an encrypted foundry keystore:
#   cast wallet import deployer --interactive
# and scripts use  --account deployer  (see the justfile).
#
# RPC URLs are public and set directly in foundry.toml [rpc_endpoints].
#
# Only genuinely-secret, optional values below. Copy to .env (gitignored) if needed.

# Sepolia contract verification via Etherscan
ETHERSCAN_API_KEY=

# optional guard-config overrides for DeployCore (sane defaults otherwise)
# GUARDIAN=
# OWNER=
